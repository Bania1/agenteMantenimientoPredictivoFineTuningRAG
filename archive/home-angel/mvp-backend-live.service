[Unit]
Description=MVP Backend for Ollama Frontend
After=network.target ollama.service
Requires=ollama.service

[Service]
Type=simple
User=angel
WorkingDirectory=/home/angel/mvp_backend
Environment=EXTRACTOR_MODEL=qwen-fusionado
Environment=RESPONSE_MODEL=llama3.2:1b
Environment=OLLAMA_GENERATE_URL=http://127.0.0.1:11434/api/generate
Environment=DEFAULT_MODE=assistant
ExecStart=/home/angel/mvp_backend/.venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
